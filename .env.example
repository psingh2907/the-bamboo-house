# Copy to .env.local and adjust. Never commit .env.local.

# true  = prototype: sample menu + illustrations shown, hidden from search engines (default)
# false = production: indexable, no preview labels
NEXT_PUBLIC_PROTOTYPE_MODE=true

# Public URL of the deployed site (canonical links, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
